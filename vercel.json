{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/:slug([0-9a-f]{8})",
      "destination": "/api/page?slug=:slug"
    },
    {
      "source": "/v/:path*",
      "destination": "/api/media?path=:path*"
    }
  ],
  "functions": {
    "api/library.js": {
      "includeFiles": "api/_clips.json"
    }
  }
}